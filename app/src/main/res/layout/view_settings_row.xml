<?xml version="1.0" encoding="utf-8"?>
<!--
    设置行（标题 + 可选副标题 + 可选开关）。圆角由 SettingsViewBuilder 按组内位置设置。

    【水平内边距只有一处来源：外层容器】
    行内不再自带 paddingStart/paddingEnd，改由 SettingsViewBuilder 的
    horizontalInset 参数统一设置（见 row_inner）。

    之前是两套叠加：卡片外距 16dp + 行内 padding 16dp。放进 CodaSheet
    （内容区本来就有 24dp）后变成 24+16+16 = 56dp，行内文字比同一容器里的
    标题右移一大截——这就是「内容偏右、标题相对偏左」的来源。
    外观上也确实每页都不同：设置页 16+16、卡片里 24+16+16。

    现在由容器决定，所以同一个容器里的标题与行文字必然对齐，
    也不会随宿主层叠而变。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/settings_card_margin"
    android:layout_marginEnd="@dimen/settings_card_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/settings_card_corner"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/row_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/row_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>