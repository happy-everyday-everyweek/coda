<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        圆角四档（#53）。

        之前全项目散落 2/3/8/14/15/16/18/19/20/22/25/26/28dp 十三种值，
        其中 14/15/16、18/19/20、25/26/28 三组相邻到看不出语义差异。
        这里定义唯一档位，新代码一律引用；旧值按需逐步替换，不一次全改。
    -->
    <dimen name="corner_small">8dp</dimen>
    <dimen name="corner_card">16dp</dimen>
    <dimen name="corner_bubble">20dp</dimen>
    <dimen name="corner_panel">28dp</dimen>

    <!--
        最小触控目标（#53 / #50 / #87）。

        之前发送 42dp、附件 40dp、返回 44dp、模型项 42dp 各写一份，
        没有任何地方声明基线。图标视觉可以更小，可点区域不得小于这个值。
    -->
    <dimen name="touch_min">48dp</dimen>

    <!-- 设置分组卡片：圆角只出现在分组首行的上边与末行的下边，中间行为直角。 -->
    <dimen name="settings_card_corner">@dimen/corner_card</dimen>
    <!-- 分组内相邻行之间的断开缝（与页面背景同色的细线）。 -->
    <dimen name="settings_card_gap">3dp</dimen>
    <!--
        卡片左右外边距。

        行为要与「标题文字」对齐，所以这里只负责卡片自身的左右间距；
        卡片内文字的左缘 = 这个值 + content_padding_h。
        标题（detail_title / 卡片标题）的水平边距也取同一个和值，
        见下面的 content_inset_total。
    -->
    <dimen name="settings_card_margin">16dp</dimen>

    <!--
        卡片内文字离卡片边缘的距离。

        与 settings_card_margin 是**两个不同层级**的量：
        margin 决定卡片边缘落在页面哪里（是否与标题对齐），
        这个值决定文字离卡片边缘多远（卡片内部排版）。
        曾经把两者绑成同一个参数，结果传 0 时文字直接贴住卡片边缘。
    -->
    <dimen name="settings_card_text_inset">16dp</dimen>

    <!--
        行/段落的水平内边距。

        这是「一层容器」的留白。之前这个值在四处各写了一遍：
        CodaSheet 内容区 24dp、页脚 20dp、设置行自带 16dp、二级页标题 16dp。
        结果是每个页面看起来的左右留白都不一样，而且行放进卡片后会叠加
        （24+16 = 40dp），文字比同一容器的标题明显偏右。

        现在统一成 20dp：比原来的 24dp 略窄（用户反馈「大部分页面都过于窄」），
        又比 16dp 宽松，是两端折中。所有容器都引用它，行本身不再自带水平
        padding（由 SettingsViewBuilder 统一设置），因此不会再叠加。
    -->
    <dimen name="content_padding_h">20dp</dimen>

    <!--
        顶层标题的水平边距 = 卡片外距 + 行内边距。

        标题在最外层，它要让文字与卡片内的文字对齐，就必须把这两层都算进来。
        写成一个具名 dimen 而不是让各处自己相加：以后调任何一个数，
        标题都会自动跟着对齐，不会出现「改了行距忘了改标题」。
    -->
    <dimen name="content_inset_total">36dp</dimen>

</resources>
