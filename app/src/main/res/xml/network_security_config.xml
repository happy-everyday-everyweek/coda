<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全策略。

  只为本机回环地址放行明文 HTTP：网关（CLIProxyAPI）跑在 proot 容器里，监听
  127.0.0.1 的普通 HTTP，App 的探测、管理面与数据面请求全部走它。Android 从
  targetSdk 28 起 usesCleartextTraffic 默认 false，会把这类请求直接拒绝——
  表现为"网关明明启动了，探测却全部超时"。

  其余域名维持默认的强制 HTTPS，不因为放行回环而放宽外网。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
